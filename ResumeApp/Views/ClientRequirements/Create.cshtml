@model ResumeApp.ViewModels.ClientRequirementCreateViewModel
@{
    ViewData["Title"] = "Add Requirement";
}

<h2>Add Requirement</h2>

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="row g-3">
            <input type="hidden" asp-for="ClientId" />
            <div class="col-12">
                <h5>Vendor Details</h5>
                <div class="row g-2">
                    <div class="col-md-3">
                        <input class="form-control" asp-for="ClientName" readonly />
                    </div>
                    <div class="col-md-3">
                        <input class="form-control" asp-for="ContactName" readonly />
                    </div>
                    <div class="col-md-3">
                        <input class="form-control" asp-for="ContactEmail" readonly />
                    </div>
                    <div class="col-md-3">
                        <input class="form-control" asp-for="ContactNumber" readonly />
                    </div>
                </div>
            </div>

            <hr />

            <div class="col-12">
                <h5>Requirement Details</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="JobTitle" class="form-label"></label>
                        <input asp-for="JobTitle" class="form-control" />
                        <span asp-validation-for="JobTitle" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Positions" class="form-label"></label>
                        <input asp-for="Positions" class="form-control" type="number" min="1" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="JobLocation" class="form-label"></label>
                        <select asp-for="JobLocation" class="form-select">
                            <option value="">-- Select --</option>
                            <option>Onsite</option>
                            <option>Remote</option>
                            <option>Hybrid</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="EmploymentType" class="form-label"></label>
                        <select asp-for="EmploymentType" class="form-select">
                            <option value="">-- Select --</option>
                            <option>Contract</option>
                            <option>Permanent</option>
                            <option>C2H (Contract-to-Hire)</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="WorkShift" class="form-label"></label>
                        <input asp-for="WorkShift" class="form-control" placeholder="e.g., IST, EST, Night Shift" />
                    </div>
                </div>
            </div>

            <hr />

            <div class="col-12">
                <h5>Job Description</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="SkillsPrimary"></label>
                        <textarea asp-for="SkillsPrimary" rows="2" class="form-control"></textarea>
                    </div>
                  

                    <div class="col-md-6">
                        <label asp-for="SkillsSecondary"></label>
                        <textarea asp-for="SkillsSecondary" rows="2" class="form-control"></textarea>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="Responsibilities"></label>
                        <textarea asp-for="Responsibilities" rows="3" class="form-control"></textarea>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="ExperienceMin"></label>
                        <input asp-for="ExperienceMin" class="form-control" type="number" min="0" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="ExperienceMax"></label>
                        <input asp-for="ExperienceMax" class="form-control" type="number" min="0" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Education"></label>
                        <input asp-for="Education" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Certifications"></label>
                        <input asp-for="Certifications" class="form-control" />
                    </div>
                </div>
            </div>

            <hr />

            <div class="col-12">
                <h5>Compensation / Budget</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="SalaryRange"></label>
                        <input asp-for="SalaryRange" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="BillingType"></label>
                        <select asp-for="BillingType" class="form-select">
                            <option value="">-- Select --</option>
                            <option>Hourly</option>
                            <option>Monthly</option>
                            <option>Fixed</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="NoticePeriod"></label>
                        <input asp-for="NoticePeriod" class="form-control" />
                    </div>
                </div>
            </div>

            <hr />

            <div class="col-12">
                <h5>Priority & Timeline</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="RequirementPriority"></label>
                        <select asp-for="RequirementPriority" class="form-select">
                            <option value="">-- Select --</option>
                            <option>High</option>
                            <option>Medium</option>
                            <option>Low</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Deadline"></label>
                        <input asp-for="Deadline" class="form-control" type="date" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ExpectedJoiningDate"></label>
                        <input asp-for="ExpectedJoiningDate" class="form-control" type="date" />
                    </div>
                </div>
            </div>

            <hr />

            <div class="col-12">
                <h5>Additional Information</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ScreeningQuestions"></label>
                        <textarea asp-for="ScreeningQuestions" rows="2" class="form-control"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SpecialInstructions"></label>
                        <textarea asp-for="SpecialInstructions" rows="2" class="form-control"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Attachments"></label>
                        <input asp-for="Attachments" type="file" class="form-control" multiple />
                    </div>
                </div>
            </div>

            <div class="col-12 text-center mt-3">
                <button type="submit" class="btn btn-primary">Submit Requirement</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
