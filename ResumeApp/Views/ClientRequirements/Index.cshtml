@using ResumeApp.Models
@model IEnumerable<ClientRequirement>

@{
    ViewData["Title"] = "Client Requirements";

    var current = ((ViewBag.Status as string) ?? "all").ToLowerInvariant();
    int page = ViewBag.CurrentPage ?? 1;
    int pageSize = ViewBag.PageSize ?? 50;
    int total = ViewBag.Total ?? (Model?.Count() ?? 0);
    int totalPages = (int)Math.Ceiling(total / (double)pageSize);

    Func<string, string> TabClass = name =>
        current == name ? "btn btn-sm btn-primary" : "btn btn-sm btn-outline-primary";

    Func<RequirementStatus, string> BadgeCss = s =>
        s switch
        {
            RequirementStatus.Active => "success",
            RequirementStatus.Hold => "warning text-dark",
            RequirementStatus.Closed => "secondary",
            _ => "secondary"
        };

    Func<int, string> PageUrl = p =>
        Url.Action("Index", "ClientRequirements",
            new { status = current, clientId = ViewBag.ClientId, page = p, pageSize });

    Func<string, string> StatusUrl = name =>
        Url.Action("Index", "ClientRequirements",
            new { status = name, clientId = ViewBag.ClientId, page = 1, pageSize });
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Client Requirements</h3>
    <div class="btn-group">
        <a class="@TabClass("all")" href="@StatusUrl("all")">All</a>
        <a class="@TabClass("active")" href="@StatusUrl("active")">Active</a>
        <a class="@TabClass("hold")" href="@StatusUrl("hold")">Hold</a>
        <a class="@TabClass("closed")" href="@StatusUrl("closed")">Closed</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No requirements found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle shadow-sm border rounded">
            <thead class="bg-light">
                <tr class="text-muted small">
                    <th>Client</th>
                    <th>Job</th>
                    <th>Details</th>
                    <th>Skills</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Ageing</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var r in Model)
                {
                    var days = (DateTime.Now.Date - r.CreatedAt.ToLocalTime().Date).Days;

                    string ageingClass = days switch
                    {
                        <= 5 => "bg-success-subtle text-success",
                        <= 15 => "bg-warning-subtle text-dark",
                        _ => "bg-light text-muted"
                    };

                    <tr data-row-id="@r.Id">

                        <td class="fw-semibold">@r.Client?.CompanyName</td>

                        <td>
                            <div class="fw-bold">@r.JobTitle</div>
                            <small class="text-muted">@r.EmploymentType</small>
                        </td>

                        <td>
                            <div><strong>@r.Positions</strong> Positions</div>
                            <small class="text-muted">@r.JobLocation</small>
                        </td>

                        <td style="max-width:200px;">
                            @{
                                var skills = (r.SkillsPrimary ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries);
                            }
                            @foreach (var s in skills.Take(3))
                            {
                                <span class="badge bg-light text-dark border me-1 mb-1">@s.Trim()</span>
                            }
                            @if (skills.Length > 3)
                            {
                                <span class="badge bg-secondary">+@(@skills.Length - 3)</span>
                            }
                        </td>

                        <td>
                            <span class="badge bg-@(r.RequirementPriority == "High" ? "danger" : "secondary")">
                                @r.RequirementPriority
                            </span>
                        </td>

                        <!-- STATUS -->
                        <td>
                            <div class="d-flex flex-column gap-1">

                                <span class="badge bg-@BadgeCss(r.Status) status-pill">
                                    @r.Status
                                </span>

                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border dropdown-toggle w-100"
                                            data-bs-toggle="dropdown">
                                        Change
                                    </button>

                                    <ul class="dropdown-menu">
                                        <li><button class="dropdown-item change-status" data-status="Active">Active</button></li>
                                        <li><button class="dropdown-item change-status" data-status="Hold">Hold</button></li>
                                        <li><button class="dropdown-item change-status" data-status="Closed">Closed</button></li>
                                    </ul>
                                </div>

                                <small class="text-muted status-updated">
                                    @(r.StatusUpdatedAt.HasValue? r.StatusUpdatedAt.Value.ToLocalTime().ToString("dd MMM hh:mm tt") : "")
                                </small>

                            </div>
                        </td>

                        <!-- AGEING -->
                        <td>
                            <span class="badge @ageingClass px-2 py-1 small"
                                  title="@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")">
                                @days d
                            </span>
                        </td>

                        <!-- ACTIONS -->
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">

                                <button type="button"
                                        class="btn btn-sm btn-outline-success assign-btn"
                                        data-id="@r.Id">
                                    <i class="bi bi-person-plus"></i>
                                </button>

                                <a asp-action="Details"
                                       asp-route-id="@r.Id"
                                       class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>

                                @if (r.Status == RequirementStatus.Closed)
                                {
                                    <form asp-action="Delete"
                                          asp-route-id="@r.Id"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Delete this requirement?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }

                            </div>
                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-2">
            <ul class="pagination pagination-sm">
                <li class="page-item @(page <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@(page <= 1 ? "#" : PageUrl(page - 1))">Prev</a>
                </li>

                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == page ? "active" : "")">
                        <a class="page-link" href="@PageUrl(p)">@p</a>
                    </li>
                }

                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                    <a class="page-link" href="@(page >= totalPages ? "#" : PageUrl(page + 1))">Next</a>
                </li>
            </ul>
        </nav>
    }
}

<form id="antiForm" method="post">
    @Html.AntiForgeryToken()
</form>

<div class="modal fade" id="assignModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="assignModalContent"></div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {

            const anti = document.querySelector('#antiForm input[name="__RequestVerificationToken"]')?.value;

            document.addEventListener("click", async function (e) {

                // STATUS CHANGE
                if (e.target.classList.contains("change-status")) {

                    const btn = e.target;
                    const row = btn.closest("tr");
                    const id = row.getAttribute("data-row-id");
                    const status = btn.getAttribute("data-status");

                    const form = new FormData();
                    form.append("id", id);
                    form.append("status", status);
                    if (anti) form.append("__RequestVerificationToken", anti);

                    const res = await fetch('@Url.Action("SetRequirementStatus", "ClientRequirements")', {
                        method: "POST",
                        body: form
                    });

                    const json = await res.json();

                    if (json.ok) {
                        const pill = row.querySelector(".status-pill");
                        pill.textContent = json.status;
                        pill.className = 'badge bg-' + (json.status === "Active" ? "success" :
                                                       json.status === "Hold" ? "warning text-dark" : "secondary") + ' status-pill';

                        const meta = row.querySelector(".status-updated");
                        if (meta && json.updatedAt) {
                            meta.textContent = new Date(json.updatedAt).toLocaleString();
                        }
                    }
                }

                // ASSIGN MODAL
                if (e.target.closest(".assign-btn")) {
                    const btn = e.target.closest(".assign-btn");
                    const id = btn.getAttribute("data-id");

                    const html = await fetch('/ClientRequirements/AssignRecruiters/' + id).then(r => r.text());
                    document.getElementById("assignModalContent").innerHTML = html;

                    new bootstrap.Modal(document.getElementById("assignModal")).show();
                }

            });

        })();
    </script>
}