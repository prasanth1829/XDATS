@using ResumeApp.Models
@model IEnumerable<ClientRequirement>

@{
    ViewData["Title"] = "Client Requirements";
    var current = ((ViewBag.Status as string) ?? "all").ToLowerInvariant();
    int page = ViewBag.CurrentPage ?? 1;
    int pageSize = ViewBag.PageSize ?? 50;
    int total = ViewBag.Total ?? (Model?.Count() ?? 0);
    int totalPages = (int)Math.Ceiling(total / (double)pageSize);

    Func<string, string> TabClass = name =>
        current == name ? "btn btn-sm btn-primary" : "btn btn-sm btn-outline-primary";

    Func<RequirementStatus, string> BadgeCss = s =>
    {
        switch (s)
        {
            case RequirementStatus.Active: return "success";
            case RequirementStatus.Hold: return "warning text-dark";
            case RequirementStatus.Closed: return "secondary";
            default: return "secondary";
        }
    };
    Func<int, string> PageUrl = p =>
        Url.Action("Index", "ClientRequirements",
            new { status = current, clientId = ViewBag.ClientId, page = p, pageSize });

    Func<string, string> StatusUrl = name =>
        Url.Action("Index", "ClientRequirements",
            new { status = name, clientId = ViewBag.ClientId, page = 1, pageSize });

}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Client Requirements</h3>
    <div class="btn-group">
        <a class="@TabClass("all")" href="@StatusUrl("all")">All</a>
        <a class="@TabClass("active")" href="@StatusUrl("active")">Active</a>
        <a class="@TabClass("hold")" href="@StatusUrl("hold")">Hold</a>
        <a class="@TabClass("closed")" href="@StatusUrl("closed")">Closed</a>
    </div>
</div>
@if (ViewBag.ClientId != null)
{
    <div class="alert alert-info d-flex align-items-center justify-content-between">
        <div>
            <i class="bi bi-building me-2"></i>
            Showing requirements for
            <strong>@ViewBag.ClientName</strong>
        </div>
        <a asp-action="Index"
           asp-route-status="@current"
           class="btn btn-sm btn-outline-secondary">
            View All Clients
        </a>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No requirements found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>Vendor</th>
                    <th>Job Title</th>
                    <th>Positions</th>
                    <th>Location</th>
                    <th>Employment</th>
                    <th>Skills</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr data-row-id="@r.Id">
                        <td>@r.Client?.CompanyName</td>
                        <td>@r.JobTitle</td>
                        <td>@r.Positions</td>
                        <td>@r.JobLocation</td>
                        <td>@r.EmploymentType</td>
                        <td>@r.SkillsPrimary</td>
                        <td>@r.RequirementPriority</td>
                        <td>
                            <span class="badge bg-@BadgeCss(r.Status) status-pill me-2">@r.Status</span>
                            <div class="dropdown d-inline-block">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    Change
                                </button>
                                <ul class="dropdown-menu">
                                    <li><button class="dropdown-item change-status" data-status="Active">Active</button></li>
                                    <li><button class="dropdown-item change-status" data-status="Hold">Hold</button></li>
                                    <li><button class="dropdown-item change-status" data-status="Closed">Closed</button></li>
                                </ul>
                            </div>
                            <div class="small text-muted">
                                @(r.StatusUpdatedAt.HasValue ? $"Updated: {r.StatusUpdatedAt.Value.ToLocalTime():g}" : "")
                            </div>
                        </td>
                        <td>@r.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <div class="btn-group">
                                <a asp-action="Details"
                                   asp-route-id="@r.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>
                                @* Show Delete only when status is Closed *@
                                @if (r.Status == RequirementStatus.Closed)
                                {
                                    <form asp-action="Delete"
                                          asp-route-id="@r.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete this closed requirement? It will be hidden from all lists.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger ms-1">
                                            Delete
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-2">
            <ul class="pagination pagination-sm">
                <li class="page-item @(page <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@(page <= 1 ? "#" : PageUrl(page - 1))">Prev</a>
                </li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == page ? "active" : "")">
                        <a class="page-link" href="@PageUrl(p)">@p</a>
                    </li>
                }
                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                    <a class="page-link" href="@(page >= totalPages ? "#" : PageUrl(page + 1))">Next</a>
                </li>
            </ul>
        </nav>
    }
}

<form id="antiForm" method="post">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        (function(){
          const tokenInput = document.querySelector('#antiForm input[name="__RequestVerificationToken"]');
          const anti = tokenInput ? tokenInput.value : null;

          function badgeClass(status){
            switch(status){
              case 'Active': return 'success';
              case 'Hold':   return 'warning text-dark';
              case 'Closed': return 'secondary';
              default:       return 'secondary';
            }
          }

          document.querySelectorAll('.change-status').forEach(btn=>{
            btn.addEventListener('click', async function(){
              const row = this.closest('tr[data-row-id]');
              const id = row?.getAttribute('data-row-id');
              const status = this.getAttribute('data-status');
              if(!id || !status) return;

              const form = new FormData();
              form.append('id', id);
              form.append('status', status);
              if (anti) form.append('__RequestVerificationToken', anti);

              try{
                const res = await fetch('@Url.Action("SetRequirementStatus", "ClientRequirements")', {
                  method: 'POST',
                  body: form
                });
                if(!res.ok){ alert('Failed to update status.'); return; }
                const json = await res.json();
                if(!json.ok){ alert('Update blocked.'); return; }

                // Update UI
                const pill = row.querySelector('.status-pill');
                pill.textContent = json.status;
                pill.className = 'badge bg-' + badgeClass(json.status) + ' status-pill me-2';

                const meta = row.querySelector('td:nth-child(8) .small.text-muted');
                if (meta && json.updatedAt) {
                  const dt = new Date(json.updatedAt);
                  meta.textContent = 'Updated: ' + dt.toLocaleString();
                }
              }catch(e){
                console.error(e);
                alert('Unexpected error.');
              }
            });
          });
        })();
    </script>
}
