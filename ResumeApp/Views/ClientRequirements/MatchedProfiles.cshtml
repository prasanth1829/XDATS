@model IEnumerable<ResumeApp.Models.Resume>
@{
    var requirement = ViewBag.Requirement as ResumeApp.Models.ClientRequirement;
    ViewData["Title"] = "Matched Profiles";
}

<div class="container py-4">
    <h2 class="mb-3 text-primary">Matched Profiles for: @requirement.JobTitle</h2>

    <div class="card mb-4">
        <div class="card-body">
            <h5>Requirement Details</h5>
            <p><strong>Vendor:</strong> @requirement.Client?.CompanyName</p>
            <p><strong>Primary Skills:</strong> @requirement.SkillsPrimary</p>
            <p><strong>Secondary Skills:</strong> @requirement.SkillsSecondary</p>
            <p><strong>Experience:</strong> @requirement.ExperienceMin - @requirement.ExperienceMax years</p>
            <p><strong>Priority:</strong> @requirement.RequirementPriority</p>
        </div>
    </div>

    @if (Model.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Skills</th>
                    <th>Experience (Years)</th>
                    <th>Resume</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Name</td>
                    <td>@r.Email</td>
                    <td>@r.Phone</td>
                    <td>@r.Skills</td>
                    <td>@r.YearsOfExperience</td>
                        <td>
                            <a asp-controller="Resume" asp-action="Details" asp-route-id="@r.Id"
                               class="btn btn-sm btn-outline-primary">View Resume</a>

                        </td>

                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning">⚠ No resumes matched this requirement.</div>
    }
</div>
