@model List<ResumeApp.ViewModels.ClientShareRowVm>
@{
    // Build absolute logo URL so it renders when pasted into email clients
    var logoRelative = Url.Content("~/images/logo.png");
    var logoAbsolute = string.Concat(
        Context.Request.Scheme, "://", Context.Request.Host.ToUriComponent(), logoRelative
    );

    string fmtDate(DateTime? d) => d.HasValue ? d.Value.ToString("dd-MMM-yy") : "";
    string decOrBlank(decimal? d) => d.HasValue ? d.Value.ToString("0.#") : "";
}

// Minimal inline styles for email clients (Gmail/Outlook)
<style>
    .xeedo-wrap {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 14px;
        color: #222;
    }

    .xeedo-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 8px;
    }

        .xeedo-header img {
            height: 36px;
        }

    .xeedo-sub {
        color: #555;
        font-size: 12px;
        margin-bottom: 10px;
    }

    .xeedo-table {
        border-collapse: collapse;
        width: 100%;
    }

        .xeedo-table th, .xeedo-table td {
            border: 1px solid #d9d9d9;
            padding: 8px;
            vertical-align: top;
        }

        .xeedo-table th {
            background: #f3f6fa;
            text-align: left;
            white-space: nowrap;
        }
</style>

<div class="xeedo-wrap">
    <div class="xeedo-header">
        <img src="@logoAbsolute" alt="Xeedo" />
        <div style="font-weight:600;">Candidate Submission</div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="xeedo-sub">No Panel-Shortlisted candidates to share.</div>
    }
    else
    {
        // Derive header context from the first row
        var first = Model.First();
        <div class="xeedo-sub">
            <div><strong>Date:</strong> @fmtDate(first.RowDate ?? DateTime.Today)</div>
            <div><strong>Client Name:</strong> @first.ClientName</div>
            <div><strong>Skill:</strong> @first.Skill</div>
        </div>

        <table class="xeedo-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Client Name</th>
                    <th>Skill</th>
                    <th>Name</th>
                    <th>Contact No</th>
                    <th>Email Id</th>
                    <th>Date of Birth</th>
                    <th>Qualification</th>
                    <th>Tot Yrs Of Exp</th>
                    <th>Rel Yrs of Exp</th>
                    <th>Current CTC</th>
                    <th>ECTC</th>
                    <th>Notice Period</th>
                    <th>Current Company</th>
                    <th>Current Location</th>
                    <th>Preferred Location</th>
                    <th>Source</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@fmtDate(r.RowDate ?? DateTime.Today)</td>
                        <td>@r.ClientName</td>
                        <td>@r.Skill</td>
                        <td>@r.Candidate</td>
                        <td>@r.Phone</td>
                        <td>@r.Email</td>
                        <td>@fmtDate(r.DateOfBirth)</td>
                        <td>@r.Qualification</td>
                        <td>@decOrBlank(r.TotalYearsExp)</td>
                        <td>@decOrBlank(r.RelevantYearsExp)</td>
                        <td>@r.CurrentCTC</td>
                        <td>@r.ExpectedCTC</td>
                        <td>@r.NoticePeriod</td>
                        <td>@r.CurrentCompany</td>
                        <td>@r.CurrentLocation</td>
                        <td>@r.PreferredLocation</td>
                        <td>@r.Source</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="xeedo-sub" style="margin-top:6px;">
            Tip: Use the “Copy Table” button and paste into your email.
        </div>
    }
</div>
