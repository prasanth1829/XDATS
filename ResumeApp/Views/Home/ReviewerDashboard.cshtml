@using Microsoft.AspNetCore.Identity
@inject UserManager<ResumeApp.Models.Users> UserManager
@{
    ViewData["Title"] = "Reviewer Dashboard";
    var user = await UserManager.GetUserAsync(User);
}

<div class="container py-5">
    <!-- Welcome Section -->
    <div class="text-center mb-5">
        <h2 class="fw-bold text-success">
            <i class="bi bi-speedometer2 me-2"></i> Reviewer Dashboard
        </h2>
        <p class="text-muted">
            Welcome back, <strong>@user?.FullName</strong>.
            Manage resumes, clients, and requirements efficiently.
        </p>
    </div>

    <!-- Dashboard Cards -->
    <div class="row g-4">  
        <!-- Assigned Resumes -->
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column text-center">
                    <div class="mb-3">
                        <i class="bi bi-file-earmark-person text-success" style="font-size:2.5rem;"></i>
                    </div>
                    <h5 class="card-title fw-semibold">Assigned Resumes</h5>
                    <p class="card-text text-muted">View and review resumes assigned to you.</p>
                    <a asp-controller="Resume" asp-action="MyUploads"
                       class="btn btn-outline-success mt-auto">Review Resumes</a>
                </div>
            </div>
        </div>
        
        <!-- Client Onboarding -->
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column text-center">
                    <div class="mb-3">
                        <i class="bi bi-building-add text-primary" style="font-size:2.5rem;"></i>
                    </div>
                    <h5 class="card-title fw-semibold">Client Onboarding</h5>
                    <p class="card-text text-muted">Add new clients and manage their onboarding process.</p>
                    <a asp-controller="UserManagement" asp-action="ClientOnboarding"
                       class="btn btn-outline-primary mt-auto">Onboard Client</a>
                </div>
            </div>
        </div>

        <!-- Client List -->
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column text-center">
                    <div class="mb-3">
                        <i class="bi bi-people text-info" style="font-size:2.5rem;"></i>
                    </div>
                    <h5 class="card-title fw-semibold">Client List</h5>
                    <p class="card-text text-muted">Browse and manage all your clients in one place.</p>
                    <a asp-controller="UserManagement" asp-action="ClientList"
                       class="btn btn-outline-info mt-auto">View Clients</a>
                </div>
            </div>
        </div>

        <!-- Requirements -->
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column text-center">
                    <div class="mb-3">
                        <i class="bi bi-briefcase-fill text-warning" style="font-size:2.5rem;"></i>
                    </div>
                    <h5 class="card-title fw-semibold">Requirements</h5>
                    <p class="card-text text-muted">Track client requirements and match profiles.</p>
                    <a asp-controller="ClientRequirements" asp-action="Index"
                       class="btn btn-outline-warning mt-auto">Manage Requirements</a>
                </div>
            </div>
        </div>
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title">📌 My Assigned JDs</h5>
                <p class="card-text">View all job descriptions assigned to you by Admin.</p>
                <a asp-controller="Dashboard" asp-action="MyAssignments" class="btn btn-primary">
                    View Assignments
                </a>
            </div>
        </div>

    </div>
</div>
