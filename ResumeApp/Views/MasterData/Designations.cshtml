@model IEnumerable<ResumeApp.Models.Designation>
@{
    ViewData["Title"] = "Designations";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">
            <i class="bi bi-person-badge me-2"></i> Designations
        </h3>
        <a asp-action="CreateDesignation" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add Designation
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning shadow-sm">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:44px;">#</th>
                        <th>Name</th>
                        <th>Active</th>
                        <th>Sort</th>
                        <th style="width:160px;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var i = 0;
                        foreach (var d in Model.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
                        {
                            i++;
                            <tr>
                                <td class="text-muted">@i</td>
                                <td>@d.Name</td>
                                <td>
                                    @if (d.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {

                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>@d.SortOrder</td>
                                <td class="text-end">
                                    <a asp-action="EditDesignation" asp-route-id="@d.Id"
                                       class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <form asp-action="DeleteDesignation" asp-route-id="@d.Id" method="post"
                                          class="d-inline" onsubmit="return confirm('Delete @d.Name?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
