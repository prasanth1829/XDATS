@model IEnumerable<ResumeApp.Models.Location>
@{
    ViewData["Title"] = "Locations";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0"><i class="bi bi-geo-alt me-2"></i> Locations</h3>
        <a asp-action="CreateLocation" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add Location
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:44px;">#</th>
                        <th>Location</th>
                        <th>Country</th>
                        <th>State / Province</th>
                        <th>Active</th>
                        <th>Sort</th>
                        <th class="text-end" style="width:160px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @{
                    var ordered = (Model ?? Enumerable.Empty<ResumeApp.Models.Location>())
                                  .OrderBy(l => l.Country!.Name)
                                  .ThenBy(l => l.SortOrder)
                                  .ThenBy(l => l.Name);
                    var i = 0;

                    foreach (var l in ordered)
                    {
                        i++;
                        <tr>
                            <td class="text-muted">@i</td>
                            <td>@l.Name</td>
                            <td>@(l.Country?.Name ?? "-")</td>
                            <td>@(string.IsNullOrWhiteSpace(l.StateOrProvince) ? "-" : l.StateOrProvince)</td>
                            <td>
                                @if (l.IsActive)
                                { <span class="badge bg-success">Active</span> }
                                else
                                { <span class="badge bg-secondary">Inactive</span> }
                            </td>
                            <td>@l.SortOrder</td>
                            <td class="text-end">
                                <a asp-action="EditLocation"
                                   asp-route-id="@l.Id"
                                   class="btn btn-sm btn-outline-primary me-1"
                                   title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                    <form asp-action="DeleteLocation"
                                          asp-route-id="@l.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit='return confirm("Delete location @l.Name?");'>

                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }

                    if (!ordered.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No locations found. Click <strong>Add Location</strong> to create one.
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
