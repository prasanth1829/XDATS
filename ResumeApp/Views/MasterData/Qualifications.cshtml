@using ResumeApp.Models
@using ResumeApp.Models.Master
@model IEnumerable<Qualification>

@{
    ViewData["Title"] = "Qualifications";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">
                <i class="bi bi-mortarboard me-2"></i>Qualifications
            </h3>
            <small class="text-muted">Master list of educational qualifications used in JDs.</small>
        </div>

        <a asp-action="CreateQualification" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add Qualification
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No qualifications found. Click <strong>Add Qualification</strong> to create one.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60px;">#</th>
                                <th>Name</th>
                                <th style="width: 120px;">Sort Order</th>
                                <th style="width: 100px;">Active</th>
                                <th style="width: 160px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var i = 1;
                            }
                            @foreach (var q in Model)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td>@q.Name</td>
                                    <td>@q.SortOrder</td>
                                    <td>
                                        @if (q.IsActive)
                                        {
                                            <span class="badge bg-success">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="EditQualification"
                                           asp-route-id="@q.Id"
                                           class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <form asp-action="DeleteQualification"
                                              asp-route-id="@q.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Delete this qualification?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
