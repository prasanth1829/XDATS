@model IEnumerable<ResumeApp.Models.Country>
@{
    ViewData["Title"] = "Countries";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0"><i class="bi bi-flag me-2"></i> Countries</h3>
        <a asp-action="CreateCountry" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add Country
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:44px;">#</th>
                        <th>Name</th>
                        <th>ISO</th>
                        <th>Active</th>
                        <th>Sort</th>
                        <th class="text-end" style="width:160px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var ordered = Model?.OrderBy(x => x.SortOrder).ThenBy(x => x.Name) ?? Enumerable.Empty<ResumeApp.Models.Country>();
                        var i = 0;
                        foreach (var c in ordered)
                        {
                            i++;
                            <tr>
                                <td class="text-muted">@i</td>
                                <td>@c.Name</td>
                                <td>@(string.IsNullOrWhiteSpace(c.IsoCode) ? "-" : c.IsoCode)</td>
                                <td>
                                    @if (c.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {

                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>@c.SortOrder</td>
                                <td class="text-end">
                                    <a asp-action="EditCountry"
                                       asp-route-id="@c.Id"
                                       class="btn btn-sm btn-outline-primary me-1"
                                       title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <form asp-action="DeleteCountry"
                                          asp-route-id="@c.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete country &quot;@c.Name&quot;?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }

                        if (!ordered.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    No countries found. Click <strong>Add Country</strong> to create one.
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
