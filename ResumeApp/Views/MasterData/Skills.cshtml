@model IEnumerable<ResumeApp.Models.Skill>

@{
    ViewData["Title"] = "Skills Master";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary mb-0">Skills Master</h2>
        <a asp-action="CreateSkill" class="btn btn-primary btn-sm">
            ➕ Add Skill
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-light">
            <strong>Existing Skills</strong>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-3 text-muted">
                    No skills found. Click "Add Skill" to create one.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:40px;">#</th>
                                <th>Name</th>
                                <th>Sort Order</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Updated</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var i = 1;
                                foreach (var s in Model)
                                {
                                    <tr>
                                        <td>@i</td>
                                        <td>@s.Name</td>
                                        <td>@s.SortOrder</td>
                                        <td>
                                            @if (s.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                        <td>@s.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@(s.UpdatedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                        <td class="text-end">
                                            <a asp-action="EditSkill"
                                               asp-route-id="@s.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <form asp-action="DeleteSkill"
                                                  asp-route-id="@s.Id"
                                                  method="post"
                                                  class="d-inline ms-1"
                                                  onsubmit="return confirm('Delete this skill?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
