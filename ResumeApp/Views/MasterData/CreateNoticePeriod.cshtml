@model ResumeApp.Models.Master.NoticePeriodOption
@{
    ViewData["Title"] = "Add Notice Period Option";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">
            <i class="bi bi-clock-history me-2"></i>Add Notice Period Option
        </h3>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <form asp-action="CreateNoticePeriod" method="post" class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g., 0–15 days, 1 month" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="SortOrder" class="form-label">Sort Order</label>
                    <input asp-for="SortOrder" class="form-control" type="number" />
                    <span asp-validation-for="SortOrder" class="text-danger"></span>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>

                <div class="col-12 mt-3">
                    <a asp-action="NoticePeriods" class="btn btn-outline-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
