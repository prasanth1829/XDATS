@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="card shadow-sm border-0 mx-auto" style="max-width:600px;">
        <div class="card-body">
            <h1 class="text-danger fw-bold mb-3">🚫 Access Denied</h1>
            <p class="text-muted mb-4">
                You don’t have permission to view this page.
                @if (ViewBag.ReturnUrl != null)
                {
                    <span class="small d-block">Requested: <code>@ViewBag.ReturnUrl</code></span>
                }
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a href="javascript:history.back()" class="btn btn-outline-secondary">⬅️ Go Back</a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">🏠 Dashboard</a>
            </div>
        </div>
    </div>
</div>