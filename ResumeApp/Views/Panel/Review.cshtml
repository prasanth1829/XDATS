@using ResumeApp.Models
@model ResumeRequirementLink

@{
    ViewData["Title"] = "Review Candidate";
    var resume = Model?.Resume;

    // URL for the detailed resume page (new tab)
    var resumeDetailsUrl = Url.Action("Details", "Resume", new { id = Model.ResumeId });
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h3 class="mb-0">Review Candidate</h3>
    <div class="d-flex gap-2">
        <a class="btn btn-light btn-sm"
           href="@Url.Action("Index", "Panel", new { requirementId = Model.RequirementId })">
            ← Back to Panel List
        </a>
    </div>
</div>

@if (resume == null)
{
    <div class="alert alert-danger">Resume not found.</div>
}
else
{
    <div class="row g-3">
        <!-- Left: Candidate details -->
        <div class="col-12 col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-2">@resume.Name</h5>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="p-3 border rounded-3 h-100">
                                <div class="text-muted small mb-1">Email</div>
                                <div class="fw-semibold">@resume.Email</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="p-3 border rounded-3 h-100">
                                <div class="text-muted small mb-1">Phone</div>
                                <div class="fw-semibold">@resume.Phone</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="p-3 border rounded-3 h-100">
                                <div class="text-muted small mb-1">Experience</div>
                                <div class="fw-semibold">@resume.YearsOfExperience @("years")</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="p-3 border rounded-3 h-100">
                                <div class="text-muted small mb-1">Uploaded</div>
                                <div class="fw-semibold">@resume.UploadedAt.ToLocalTime()</div>
                            </div>
                        </div>
                    </div>

                    @* Skills *@
                    @if (!string.IsNullOrWhiteSpace(resume.Skills))
                    {
                        <div class="mt-3">
                            <strong>Skills</strong>
                            <div class="small">@resume.Skills</div>
                        </div>
                    }

                    @* Experience Summary + "View Full Resume" button directly below *@
                    @if (!string.IsNullOrWhiteSpace(resume.Experience))
                    {
                        <div class="mt-3">
                            <strong>Experience Summary</strong>
                            <div class="small" style="white-space:pre-wrap">@resume.Experience</div>

                            <div class="mt-3">
                                <a class="btn btn-outline-primary btn-sm"
                                   href="@resumeDetailsUrl"
                                   target="_blank" rel="noopener">
                                    View Full Resume
                                </a>
                            </div>
                        </div>
                    }

                    @* Uploader Remark *@
                    @if (!string.IsNullOrWhiteSpace(resume.Remark))
                    {
                        <div class="mt-3">
                            <strong>Uploader Remark</strong>
                            <div class="small" style="white-space:pre-wrap">@resume.Remark</div>
                        </div>
                    }

                    @* Fallback: show View Full Resume even if Experience Summary is empty *@
                    @if (string.IsNullOrWhiteSpace(resume.Experience))
                    {
                        <div class="mt-3">
                            <a class="btn btn-outline-primary btn-sm"
                               href="@resumeDetailsUrl"
                               target="_blank" rel="noopener">
                                View Full Resume
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
        <!-- Right: Panel decision -->
        <div class="col-12 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-end mb-2">
                        <a asp-controller="ClientRequirements"
                           asp-action="FullDetails"
                           asp-route-id="@Model.RequirementId"
                           target="_blank"
                           class="btn btn-sm btn-outline-success">
                            📄 View JD
                        </a>
                    </div>
                    <h6 class="card-title">Panel Decision</h6>

                    <div class="mb-2 small text-muted">
                        Current Status: <strong>@Model.Status</strong> <br />
                        Last Updated: <strong>@Model.UpdatedAt.ToLocalTime()</strong>
                        @if (!string.IsNullOrWhiteSpace(Model.LastComment))
                        {
                            <div>Remark: <em>@Model.LastComment</em></div>
                        }
                    </div>

                    <form asp-controller="Panel" asp-action="Decide" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="requirementId" value="@Model.RequirementId" />
                        <input type="hidden" name="resumeId" value="@Model.ResumeId" />

                        <div class="mb-2">
                            <label class="form-label">Remark (optional)</label>
                            <textarea class="form-control" name="remark" rows="3" placeholder="Add your feedback"></textarea>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button name="decision" value="select" type="submit" class="btn btn-success">
                                ✅ Screen Select
                            </button>
                            <button name="decision" value="hold" type="submit" class="btn btn-warning">
                                ⏸ Hold
                            </button>
                            <button name="decision" value="reject" type="submit" class="btn btn-danger">
                                ❌ Screen Reject
                            </button>
                        </div>
                    </form>

                    <hr />
                    <div class="small text-muted">
                        <strong>Recent History</strong>
                        <div class="mt-1">
                            <span class="text-muted">History view not wired — optional.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
