@model IEnumerable<ResumeApp.Models.Users>

@{
    ViewData["Title"] = "Pending User Approvals";
}

<h2>Pending User Approvals</h2>

@if (!Model.Any())
{
    <div class="alert alert-success">All users have been approved!</div>
}
else
{
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>
                        <form asp-action="Approve" asp-route-id="@user.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-success btn-sm">Approve</button>
                        </form>
                        <form asp-action="Deny" asp-route-id="@user.Id" method="post" class="d-inline ms-1" onsubmit="return confirm('Are you sure you want to deny this user?');">
                            <button type="submit" class="btn btn-danger btn-sm">Deny</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
