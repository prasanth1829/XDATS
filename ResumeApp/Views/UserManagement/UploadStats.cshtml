@model IEnumerable<ResumeApp.ViewModels.UserUploadStatsViewModel>
@{
    ViewData["Title"] = "Upload Statistics";
    string range = ViewBag.Range ?? "today";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-primary">Upload Statistics (@range)</h2>
    <div class="btn-group">
        <a asp-action="ExportUploadStats" asp-route-range="@range" asp-route-format="excel" class="btn btn-success btn-sm">
            <i class="bi bi-file-earmark-excel"></i> Excel
        </a>
        <a asp-action="ExportUploadStats" asp-route-range="@range" asp-route-format="pdf" class="btn btn-danger btn-sm">
            <i class="bi bi-file-earmark-pdf"></i> PDF
        </a>
    </div>
</div>
<div class="mb-3">
    <a class="btn btn-outline-primary btn-sm @(range == "today" ? "active" : "")" asp-action="UploadStats" asp-route-range="today">Today</a>
    <a class="btn btn-outline-primary btn-sm @(range == "month" ? "active" : "")" asp-action="UploadStats" asp-route-range="month">This Month</a>
</div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th class="text-center">Resumes Uploaded</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted">No uploads found for this period.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@item.Email</td>
                            <td class="text-center fw-bold">@item.UploadCount</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
