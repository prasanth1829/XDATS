@model ResumeApp.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    var today = DateTime.Now.ToString("dddd, dd MMM yyyy");
    var todayWork = ViewBag.TodayWork as List<ResumeApp.ViewModels.UserDailyWorkDto>;

}

<div class="container-fluid px-4 py-4 dashboard-bg">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Admin Dashboard</h2>
            <div class="text-muted">
                System-wide recruitment overview · @today
            </div>
        </div>

        <div>
            <a asp-controller="ClientRequirements" asp-action="Index"
               class="btn btn-primary me-2">
                + New Requirement
            </a>
            <a asp-controller="UserManagement" asp-action="ClientList"
               class="btn btn-outline-primary">
                + Client
            </a>
        </div>
    </div>
     
    <div class="kpi-2row-grid mb-4">

    <!-- TOTAL RESUMES -->
    <a class="kpi-box submitted" href="/Resume/List">
        <span class="label">Total Resumes</span>
        <span class="value">@Model.Kpis.TotalResumes</span>
    </a>

    <!-- PROFILES IN PROGRESS -->
    <a class="kpi-box pipeline"
       href="@Url.Action(
            "InProgressProfiles",
            "ClientRequirements",
            new {
                statuses = new[] {
                    CandidateStatus.New,
                    CandidateStatus.Shortlisted,
                    CandidateStatus.PanelShortlisted,
                    CandidateStatus.InterviewScheduled,
                    CandidateStatus.Hold
                }
            })">
        <span class="label">Profiles In Progress</span>
        <span class="value">@Model.Kpis.ProfilesInProgress</span>
    </a>

    <!-- PANEL PENDING -->
    <a class="kpi-box screening"
       href="@Url.Action(
            "InProgressProfiles",
            "ClientRequirements",
            new { statuses = new[] { CandidateStatus.PanelShortlisted } })">
        <span class="label">Panel Pending</span>
        <span class="value">@Model.Pipeline.PanelShortlisted</span>
    </a>

    <!-- INTERVIEW SCHEDULED -->
    <a class="kpi-box interview"
       href="@Url.Action(
            "InProgressProfiles",
            "ClientRequirements",
            new { statuses = new[] { CandidateStatus.InterviewScheduled } })">
        <span class="label">Interviews Scheduled</span>
        <span class="value">@Model.Kpis.InterviewsScheduled</span>
    </a>

    <!-- SELECTED -->
    <a class="kpi-box success"
       href="@Url.Action(
            "SharedProfilesByStatus",
            "ClientRequirements",
            new { status = CandidateStatus.Selected })">
        <span class="label">Selected</span>
        <span class="value">@Model.Pipeline.Selected</span>
    </a>

    <!-- OFFER RELEASED -->
    <a class="kpi-box offer"
       href="@Url.Action(
            "SharedProfilesByStatus",
            "ClientRequirements",
            new { status = CandidateStatus.OfferReleased })">
        <span class="label">Offers Released</span>
        <span class="value">@Model.Pipeline.OfferReleased</span>
    </a>

    <!-- JOINED -->
    <a class="kpi-box joined"
       href="@Url.Action(
            "SharedProfilesByStatus",
            "ClientRequirements",
            new { status = CandidateStatus.Joined })">
        <span class="label">Joined</span>
        <span class="value">@Model.Pipeline.Joined</span>
    </a>

    <!-- ON HOLD -->
    <a class="kpi-box followup"
       href="@Url.Action(
            "InProgressProfiles",
            "ClientRequirements",
            new { statuses = new[] { CandidateStatus.Hold } })">
        <span class="label">On Hold</span>
        <span class="value">@Model.Pipeline.Hold</span>
    </a>

</div>


<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white fw-semibold d-flex align-items-center">
        <span class="me-2">🏢</span>
        <span>Client Overview</span>

        <span class="badge bg-light ms-auto">
            @Model.ClientPerformance.Count Clients
        </span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Client</th>
                    <th>Openings</th>
                    <th>Submission</th>
                    <th>Pipeline</th>
                    <th>IV Scheduled</th>
                    <th>Offer Released</th>
                    <th>Declined</th>
                    <th>Joined</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.ClientPerformance)
                {
                    <tr>
                        <td class="fw-semibold">@c.ClientName</td>
                        <td>@c.Openings</td>
                        <td>@c.Submissions</td>
                        <td>@c.Pipeline</td>
                        <td>@c.InterviewScheduled</td>
                        <td>@c.OfferReleased</td>
                        <td>@c.Joined</td>
                        <td>@c.Declined</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>



@if (todayWork != null && todayWork.Any())
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white fw-semibold d-flex align-items-center gap-2">
    <span class="me-2">⏱️</span>
    <span>Who worked how much today?</span>

    <a href="/Dashboard/WorkReport"
       class="btn btn-sm btn-outline-primary ms-auto me-2">
        View Full Report
    </a>

    <span class="badge bg-light">
        @todayWork.Count users
    </span>
</div>


        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User</th>
                        <th>First Login</th>
                        <th>Last Logout</th>
                        <th>Worked Time</th>
                        <th>Uploads</th>
                        <th>Downloads</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var u in todayWork)
                    {
                        <tr class="@(u.IsOnline ? "table-success" : "")">

                            <td class="fw-semibold">
                            @u.UserName
                        
                            @if (u.IsOnline)
                            {
                                <span class="badge bg-success ms-2">● Online</span>
                            }
                            else
                            {
                                <span class="badge bg-warning ms-2">Idle</span>
                            }
                        </td>

                            
                            <td>
                                @(u.FirstLoginTime?.ToLocalTime().ToString("hh:mm tt") ?? "-")
                            </td>

                            <td>
                                @(u.LastActivityTime?.ToLocalTime().ToString("hh:mm tt") ?? "-")
                            </td>

                            <td>
                                @{
                                    var hours = u.TotalWorkedMinutes / 60;
                                    var mins = u.TotalWorkedMinutes % 60;
                                }
                                <span class="badge bg-success">
                                    @hours h @mins m
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-primary">
                                    @u.UploadCount
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-secondary">
                                    @u.DownloadCount
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body text-muted">
            ⏱️ No user activity recorded today.
        </div>
    </div>
}
    <!-- ================= MAIN GRID ================= -->
    <div class="row g-4">

        <div class="col-xl-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-semibold">
                    Top Recruiters
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Recruiter</th>
                                <th>Uploads</th>
                                <th>Shortlisted</th>
                                <th>Interviews</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.RecruiterPerformance)
                            {
                                <tr>
                                    <td class="fw-semibold">@r.RecruiterName</td>
                                    <td>@r.Uploads</td>
                                    <td>@r.Shortlisted</td>
                                    <td>@r.Interviews</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- RECENT ACTIVITY -->
        <div class="col-xl-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-semibold">
                    Recent Activity
                </div>

                <div class="card-body">
                    @foreach (var a in Model.RecentActivities)
                    {
                        <div class="activity-item">
                            <div>@a.Message</div>
                            <small class="text-muted">@a.Timestamp.ToLocalTime()</small>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
    
    <!-- ================= ADMIN ALERTS ================= -->
    <div class="card shadow-sm border-0 mt-4">
        <div class="card-header bg-white fw-semibold d-flex align-items-center">
            <span class="me-2">⚠️</span>
            <span>System Alerts</span>
            <span class="badge bg-light ms-auto">
                @Model.Alerts.Count
            </span>
        </div>

        <div class="card-body">
            @if (Model.Alerts.Any())
            {
                foreach (var a in Model.Alerts)
                {
                    <div class="action-item @a.Type">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>@a.Message</span>

                        @if (!string.IsNullOrEmpty(a.ActionUrl))
                        {
                            <a href="@a.ActionUrl"
                               class="btn btn-sm btn-outline-dark ms-auto">
                                View
                            </a>
                        }
                    </div>
                }
            }
            else
            {
                <div class="text-muted small">
                    🎉 No system alerts at the moment
                </div>
            }
        </div>
    </div>


    <!-- ================= FUNNEL ================= -->
    <div class="row g-4 mt-4">

        <div class="col-xl-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-semibold">
                    Recruitment Funnel
                </div>
                <div class="card-body">
                    <canvas id="pipelineChart" height="120"></canvas>
                </div>
            </div>
        </div>

        <!-- QUICK ACTIONS -->
        <div class="col-xl-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-semibold">
                    Admin Quick Actions
                </div>

                <div class="card-body d-flex flex-column gap-3">

                    <a class="quick-action-card"
                       href="/UserManagement">
                        Manage Users
                        <span class="badge bg-primary ms-auto">
                            @Model.QuickCounts.TotalUsers
                        </span>
                    </a>

                    <a class="quick-action-card"
                       href="/Resume/List">
                        Resumes
                        <span class="badge bg-success ms-auto">
                            @Model.QuickCounts.TotalResumes
                        </span>
                    </a>

                    <a class="quick-action-card"
                       href="/UserManagement/UploadStats">
                        Upload Stats
                        <span class="badge bg-info ms-auto">
                            @Model.QuickCounts.UploadsToday
                        </span>
                    </a>

                    <a class="quick-action-card"
                       href="/ClientRequirements">
                        Requirements
                        <span class="badge bg-warning ms-auto">
                            @Model.QuickCounts.ActiveRequirements
                        </span>
                    </a>

                    <a class="quick-action-card"
                       href="/MasterData">
                        Master Settings
                        <span class="badge bg-secondary ms-auto">
                            Configure
                        </span>
                    </a>

                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        new Chart(document.getElementById('pipelineChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.PipelineChart.Select(x => x.Label))),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.PipelineChart.Select(x => x.Count))),
                    backgroundColor: "#3b82f6",
                    borderRadius: 6
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });
    </script>
}
