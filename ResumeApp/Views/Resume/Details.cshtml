@model ResumeApp.Models.Resume

@{
    ViewData["Title"] = "Resume Details";
}

<h2 class="mb-4">Resume Details</h2>

<div class="card shadow-sm p-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <p><strong>Name:</strong> @Model.Name</p>
        </div>
        <div class="col-md-6">
            <p><strong>Email:</strong> @Model.Email</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <p><strong>Phone:</strong> @Model.Phone</p>
        </div>
        <div class="col-md-6">
            <p><strong>Uploaded At:</strong> @Model.UploadedAt.ToString("dd MMM yyyy HH:mm")</p>
        </div>
    </div>

    <div class="mb-3">
        <p><strong>Skills:</strong></p>
        <div class="border rounded p-2 bg-light" style="white-space: pre-wrap;">@Model.Skills</div>
    </div>
    <div class="mb-3">
        <label>Years of Experience</label>
        <input asp-for="YearsOfExperience" class="form-control" readonly />
    </div>


    <div class="mb-3">
        <p><strong>Experience:</strong></p>
        <div class="border rounded p-2 bg-light" style="white-space: pre-wrap;">@Model.Experience</div>
    </div>
    @if (!string.IsNullOrEmpty(Model.FileName))
    {
        var extension = System.IO.Path.GetExtension(Model.FileName).ToLower();

        <div class="mb-4">
            <h5>Original Resume File</h5>

            @if (extension == ".pdf")
            {
                <iframe src="~/uploads/@Model.FileName" width="100%" height="600px" style="border: 1px solid #ccc;"></iframe>
            }
            else
            {
                <div class="alert alert-info">
                    Preview not supported for this file type.
                    <a href="~/uploads/@Model.FileName" class="btn btn-sm btn-primary" target="_blank">
                        Download & Open in App
                    </a>
                </div>
            }
        </div>
    }

    <a href="~/uploads/@Model.FileName" class="btn btn-outline-secondary" download>
        <i class="bi bi-download"></i> Download Resume
    </a>
 
    <div class="d-flex justify-content-between mt-4">
        <a asp-action="List" class="btn btn-secondary">← Back to List</a>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary me-2">Edit</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this resume?');">
                <button type="submit" class="btn btn-outline-danger">Delete</button>
            </form>
        </div>
    </div>
</div>
