@using Microsoft.AspNetCore.Http
@model IEnumerable<ResumeApp.Models.Resume>

@{
    ViewData["Title"] = "Parsed Resumes List";
    var isAdmin = User.IsInRole("Admin");
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int pageSize = ViewBag.PageSize ?? 100;
    int totalCount = ViewBag.TotalCount ?? 0;
}
@if (TempData["UploadSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["UploadSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["UploadError"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["UploadError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<h2 class="mb-4 fw-bold text-primary">Uploaded Resumes</h2>
<!-- Search -->
<form asp-action="List" method="get" class="card card-body mb-3 shadow-sm">

    <div class="row g-2">
        <div class="col-md-2">
            <input type="number" name="minExperience"
                   value="@ViewBag.MinExperience"
                   class="form-control"
                   placeholder="Min Exp (yrs)" />
        </div>

        <div class="col-md-4">
            <input type="text" name="mandatorySkills"
                   value="@ViewBag.MandatorySkills"
                   class="form-control"
                   placeholder="Mandatory skills (e.g. C#)" />
        </div>

        <div class="col-md-4">
            <input type="text" name="optionalSkills"
                   value="@ViewBag.OptionalSkills"
                   class="form-control"
                   placeholder="Optional skills (C++, HTML, SQL)" />
        </div>

        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary">
                🔍 Search
            </button>
        </div>
    </div>

</form>

<!-- Counter + Export -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="text-muted small">
        Showing
        @(((currentPage - 1) * pageSize) + 1)
        -
        @(Math.Min(currentPage * pageSize, totalCount))
        of @totalCount resumes
    </div>

    <div class="d-flex gap-2">
        <form asp-action="ExportToExcel" method="get" class="d-inline">
            <input type="hidden" name="search" value="@Context.Request.Query["search"]" />
            <button type="submit" class="btn btn-success btn-sm shadow-sm">
                <i class="bi bi-file-earmark-excel"></i> Excel
            </button>
        </form>
        <form asp-action="DownloadZip" method="get" class="d-inline">
            <input type="hidden" name="search" value="@Context.Request.Query["search"]" />
            <button type="submit" class="btn btn-primary btn-sm shadow-sm">
                <i class="bi bi-download"></i> ZIP
            </button>
        </form>
    </div>
</div>
<!-- Resume Table -->
<div class="card shadow-sm rounded-3">
    <div class="table-responsive" style="max-height:70vh; overflow-y:auto;">
        <table class="table table-hover align-middle table-bordered mb-0" style="table-layout: fixed; width: 100%;">
            <thead class="table-light sticky-top">
                <tr class="text-center">
                    <th style="width: 60px;">#</th>
                    <th style="width: 150px;">Name</th>
                    <th style="width: 220px;">Email</th>
                    <th style="width: 120px;">Phone</th>
                    <th style="width: 200px;">Skills</th>
                    <th style="width: 250px;">Experience</th>
                    <th style="width: 60px;">Years</th>
                    <th style="width: 150px;">Uploaded By</th>
                    <th style="width: 140px;">Actions</th>
                    <th style="width: 110px;">Remark</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted">No resumes found.</td>
                    </tr>
                }
                else
                {
                    int i = 1 + ((currentPage - 1) * pageSize);
                    foreach (var r in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td class="text-truncate" title="@r.Name">@r.Name</td>
                            <td class="text-truncate" title="@r.Email">@r.Email</td>
                            <td>@r.Phone</td>
                            <td class="text-truncate" title="@r.Skills">@r.Skills</td>
                            <td class="text-truncate" title="@r.Experience">@r.Experience</td>
                            <td>
                                <span class="badge @(r.YearsOfExperience >= 10 ? "bg-success" : "bg-secondary")">
                                    @r.YearsOfExperience
                                </span>
                            </td>
                            <td>@r.User?.FullName</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-outline-info" title="Details"><i class="bi bi-eye"></i></a>
                                    @if (isAdmin)
                                    {
                                        <form asp-action="Delete" asp-route-id="@r.Id" method="post" style="display:inline;"
                                              onsubmit="return confirm('Delete this resume?');">
                                            <button type="submit" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        data-bs-toggle="modal" data-bs-target="#remarkModal-@r.Id">
                                    <i class="bi bi-chat-square-text"></i> Remark
                                </button>

                                <!-- Modal -->
                                <div class="modal fade" id="remarkModal-@r.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <form asp-action="UpdateRemark" method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Update Remark for @r.Name</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <input type="hidden" name="id" value="@r.Id" />
                                                    <textarea name="remark" rows="4" class="form-control">@r.Remark</textarea>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="submit" class="btn btn-success">💾 Save</button>
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        i++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<!-- Pagination -->
@if (totalPages > 1)
{
    <nav class="mt-3" aria-label="Resumes pagination">
        <ul class="pagination justify-content-center">

            <!-- Prev -->
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" tabindex="@(currentPage == 1 ? "-1" : "0")"
                   href="@Url.Action("List", new { page = currentPage - 1, search = Context.Request.Query["search"] })">
                    « Prev
                </a>
            </li>

            @{
                int maxVisiblePages = 5;
                int startPage = Math.Max(1, currentPage - 2);
                int endPage = Math.Min(totalPages, startPage + maxVisiblePages - 1);
                if (endPage - startPage < maxVisiblePages - 1)
                {
                    startPage = Math.Max(1, endPage - maxVisiblePages + 1);
                }
            }

            <!-- First page + leading ellipsis -->
            @if (startPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("List", new { page = 1, search = Context.Request.Query["search"] })">1</a>
                </li>
                @if (startPage > 2)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
            }

            <!-- Middle pages -->
            @for (int p = startPage; p <= endPage; p++)
            {
                if (p == currentPage)
                {
                    <li class="page-item active" aria-current="page">
                        <span class="page-link">@p</span>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("List", new { page = p, search = Context.Request.Query["search"] })">@p</a>
                    </li>
                }
            }

            <!-- Trailing ellipsis + last page -->
            @if (endPage < totalPages)
            {
                @if (endPage < totalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("List", new { page = totalPages, search = Context.Request.Query["search"] })">@totalPages</a>
                </li>
            }

            <!-- Next -->
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" tabindex="@(currentPage == totalPages ? "-1" : "0")"
                   href="@Url.Action("List", new { page = currentPage + 1, search = Context.Request.Query["search"] })">
                    Next »
                </a>
            </li>
        </ul>
    </nav>
}
