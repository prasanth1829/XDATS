@using Azure.Core
@using Microsoft.AspNetCore.Http

@model IEnumerable<ResumeApp.Models.Resume>

@{
    ViewData["Title"] = "Parsed Resumes List";
}

@* --- Alerts for Upload Success/Error --- *@
@if (TempData["UploadSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["UploadSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["UploadError"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["UploadError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0 text-primary">Parsed Resumes</h2>
    <form asp-action="DownloadZip" method="get" class="d-inline">
        <input type="hidden" name="search" value="@Context.Request.Query["search"]" />
        <button type="submit" class="btn btn-primary px-4">
            <i class="bi bi-download me-2"></i> Download All PDFs (ZIP)
        </button>
    </form>
</div>

@* --- Search Form --- *@
<div class="mb-4">
    <form asp-action="List" method="get" class="row g-3 align-items-center">
        <div class="col-md-8 col-lg-9">
            <input type="text" name="search" value="@Context.Request.Query["search"]" class="form-control form-control-lg" placeholder="Search by name, email, skills, or experience..." aria-label="Search resumes" />
        </div>
        <div class="col-md-4 col-lg-3">
            <button type="submit" class="btn btn-outline-primary w-100 btn-lg">
                <i class="bi bi-search me-2"></i> Search
            </button>
        </div>
    </form>
</div>


@* --- Resumes Table --- *@
<div class="card shadow-lg border-0">
    <div class="card-body p-0">
        @* p-0 removes padding from card-body to allow table to span full width *@
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                @* mb-0 removes bottom margin from table *@
                <thead class="table-dark">
                    <tr>
                        <th scope="col" class="text-center">#</th>
                        <th scope="col">Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Phone</th>
                        <th scope="col">Skills</th>
                        <th scope="col">Experience</th>
                        <th scope="col" class="text-center">Years</th>
                        <th scope="col">Uploaded By</th>
                        <th scope="col" class="text-center">Actions</th>
                        <th scope="col">Remark</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">
                                <i class="bi bi-info-circle-fill me-2"></i> No resumes found matching your criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int i = 1;
                        foreach (var r in Model)
                        {
                            <tr>
                                <td class="text-center">@i</td>
                                <td><strong>@r.Name</strong></td>
                                <td class="text-truncate" style="max-width: 180px;">@r.Email</td>
                                <td>@r.Phone</td>
                                <td class="text-truncate" style="max-width: 180px;">@r.Skills</td>
                                <td>
                                    <textarea class="form-control form-control-sm" rows="3" readonly style="resize: vertical; min-height: 70px;">@r.Experience</textarea>
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill @(r.YearsOfExperience >= 10 ? "bg-success" : (r.YearsOfExperience >= 5 ? "bg-info text-dark" : "bg-secondary")) fs-6">
                                        @r.YearsOfExperience
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted">@r.User?.Email</small>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex flex-column gap-2">
                                        @* Use flexbox for vertical alignment of buttons *@
                                        <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary" title="Edit Resume">
                                            <i class="bi bi-pencil-square me-1"></i> Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                            <i class="bi bi-eye me-1"></i> Details
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@r.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this resume? This action cannot be undone.');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100" title="Delete Resume">
                                                <i class="bi bi-trash me-1"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                                <td>
                                    <form asp-action="UpdateRemark" method="post" class="d-flex align-items-end h-100">
                                        @* Align items to end for bottom alignment of save button *@
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <textarea name="remark" class="form-control form-control-sm me-1" rows="3" placeholder="Add a remark...">@r.Remark</textarea>
                                        <button type="submit" class="btn btn-sm btn-success flex-shrink-0" style="min-width: 60px;">
                                            <i class="bi bi-save"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Optional: Add a small script to auto-hide alerts after a few seconds
        document.addEventListener('DOMContentLoaded', function() {
            var alerts = document.querySelectorAll('.alert');
            alerts.forEach(function(alert) {
                setTimeout(function() {
                    new bootstrap.Alert(alert).close();
                }, 5000); // Auto-hide after 5 seconds
            });
        });
    </script>
}