@model ResumeApp.Models.RequirementMom

@{
    ViewData["Title"] = "Add Meeting Minutes";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">📝 Add MOM for Requirement #@Model.RequirementId</h3>
        <a asp-controller="ClientRequirements"
           asp-action="Details"
           asp-route-id="@Model.RequirementId"
           class="btn btn-outline-secondary btn-sm">
            ⬅️ Back to Requirement
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger mb-2"></div>

                <input type="hidden" asp-for="RequirementId" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">Title</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MeetingDate" class="form-label fw-semibold">Meeting Date</label>
                    <input asp-for="MeetingDate" type="date" class="form-control" />
                    <span asp-validation-for="MeetingDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="MinutesEditor" class="form-label fw-semibold">
                        Minutes / Discussion Points
                    </label>
                    <textarea id="MinutesEditor"
                              asp-for="Minutes"
                              class="form-control"
                              rows="12"></textarea>
                    <span asp-validation-for="Minutes" class="text-danger"></span>
                </div>


                <div class="mb-3">
                    <label class="form-label fw-semibold">Attachments (optional)</label>
                    <input type="file" name="Attachments" multiple class="form-control" />
                    <div class="form-text">
                        You can upload supporting docs (screenshots, PDFs, Excel, etc.).
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">
                    💾 Save MOM
                </button>
                <a asp-controller="ClientRequirements"
                   asp-action="Details"
                   asp-route-id="@Model.RequirementId"
                   class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- CKEditor 5 – no API key needed -->
    <script src="https://cdn.ckeditor.com/ckeditor5/41.0.0/classic/ckeditor.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const el = document.querySelector('#MinutesEditor');
            if (!el) return;

            ClassicEditor
                .create(el, {
                    toolbar: [
                        'undo', 'redo', '|',
                        'bold', 'italic', 'underline', '|',
                        'bulletedList', 'numberedList', '|',
                        'link', 'blockQuote'
                    ]
                })
                .catch(error => console.error('CKEditor init error:', error));
        });
    </script>
}
